# Placeholder only. Provisioning writes the real application URI to ignored .env.
# psycopg URI: postgresql://<APP_USER>:<URL_ENCODED_PASSWORD>@<HOST>:<PORT>/<DATABASE>
RAG_DATABASE_URL=
RAG_DB_SCHEMA=rag
# Stage/build this separate index before enabling it; the legacy FLEX tables remain intact.
RAG_INDEX_NAME=nasa_multi_v1
RAG_CORPUS_MODE=multi
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
